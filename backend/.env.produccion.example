# Solo para cargar datos desde este equipo a la base en la nube (npm run prod:seed).
# Copie este archivo como .env.produccion: nunca se sube al repositorio.
NODE_ENV=production
# Supabase → Connect → Session pooler (funciona por IPv4)
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Al menos 12 caracteres: es la clave inicial de los usuarios del sistema
SEED_PASSWORD=
# Cualquier clave aleatoria de 40 caracteres o más (estos scripts no la usan para firmar)
JWT_ACCESS_SECRET=
CORS_ORIGIN=https://erp-hotel-rosita.onrender.com
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=Habitaciones
